      LAYOUT_COOKIE,
      parseLayout,
    } from "@/lib/launchpad/list-layout";
    
    export const dynamic = "force-dynamic";
    export const metadata: Metadata = {
      alternates: { canonical: "/" },
    };
    
    const RIVER_SEED = 100;
    
    export default async function Home({
      searchParams,
    }: {
      searchParams: Promise<{
        sort?: string;
        window?: string;
